<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Магазин Zero</title>
  <style>
    body { font-family: Arial; text-align: center; background: #f3f3f3; }
